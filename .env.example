# Sendblue credentials — get these from your Sendblue dashboard
SENDBLUE_API_KEY=your_sendblue_api_key
SENDBLUE_API_SECRET=your_sendblue_api_secret
SENDBLUE_NUMBER=+1xxxxxxxxxx   # The Sendblue number that receives messages

# Your personal phone number (only this number can use the bot)
MY_PHONE=+1xxxxxxxxxx

# Anthropic API key — get this from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Canvas LMS (optional — filled in automatically when you connect via the bot)
CANVAS_TOKEN=
CANVAS_BASE_URL=

# Port for the local server
PORT=3000

# Intake mode
# POLLING_MODE=true  (default) — bot calls Sendblue every POLL_INTERVAL ms, no ngrok needed
# POLLING_MODE=false            — Sendblue pushes to your server via webhook (requires public URL)
POLLING_MODE=true
POLL_INTERVAL=5000

# SQLite database path (default: ./data/grade-brain.db)
DB_PATH=./data/grade-brain.db
